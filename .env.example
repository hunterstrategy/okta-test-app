# Public URL the app is reachable at (no trailing slash). Okta posts to ${BASE_URL}/saml/acs.
BASE_URL=http://localhost:8080

# From the Okta app's "Sign On" tab -> "Metadata URL"
SAML_IDP_METADATA_URL=https://YOUR-ORG.okta.com/app/XXXXXXXX/sso/saml/metadata

# Bearer token Okta uses for SCIM. Generate with: openssl rand -hex 32
SCIM_TOKEN=

# Cookie signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional
# REQUIRE_SCIM_USER=true            # deny SAML logins for users not pushed via SCIM
# ADMIN_USERS=you@example.com       # restrict /admin (comma-separated); empty = any signed-in user
# SAML_FORCE_AUTHN=true             # make Okta re-authenticate on every SP-initiated login
# SAML_AUTHN_CONTEXT=urn:oasis:names:tc:SAML:2.0:ac:classes:PasswordProtectedTransport
# SAML_WANT_RESPONSE_SIGNED=true    # also require the outer Response to be signed
